# Copy to .env and fill in. scripts/install.sh does this for you and
# generates the secrets below — you shouldn't normally need to touch this
# by hand.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Public domain — used for the Vite dev server's allowed-hosts check and for
# CORS_ORIGINS below. Leave blank for a pure localhost setup.
DOMAIN=portfelika.com

# Compose service DNS names — leave as-is unless you change the topology.
MONGODB_URI=mongodb://mongo:27017/klipa?replicaSet=rs0
REDIS_HOST=redis
REDIS_PORT=6379

# Comma-separated list of origins allowed by CORS (SPEC.md §10).
CORS_ORIGINS=http://localhost,http://portfelika.com,https://portfelika.com

# AES-256-GCM key for reversible email encryption (SPEC.md §4.1) — 32 bytes, hex.
EMAIL_ENCRYPTION_KEY=

# HMAC-SHA256 pepper for the email blind index (users.emailHash, SPEC.md §4.1).
EMAIL_HASH_PEPPER=
