# Copy to .env and fill in. scripts/install.sh does this for you and
# generates the secrets below — you shouldn't normally need to touch this
# by hand.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Public domain — used for the Vite dev server's allowed-hosts check and for
# CORS_ORIGINS below. Leave blank for a pure localhost setup.
DOMAIN=portfelika.com

# Compose service DNS names — leave as-is unless you change the topology.
MONGODB_URI=mongodb://mongo:27017/klipa?replicaSet=rs0
REDIS_HOST=redis
REDIS_PORT=6379

# Comma-separated list of origins allowed by CORS (SPEC.md §10).
CORS_ORIGINS=http://localhost,http://portfelika.com,https://portfelika.com

# Used to build links in emails (verification, password reset).
FRONTEND_URL=http://portfelika.com

# --- Auth (SPEC.md §10, Stage 1) ---

# HS256 signing secret for 15-minute access tokens. >=32 chars.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# D-16: registration is open; email verification is implemented but not
# enforced by default. Flip to true to require it before login — no code
# changes needed (SPEC.md Stage 1 DoD).
REQUIRE_EMAIL_VERIFICATION=false

# AES-256-GCM key for reversible email encryption (SPEC.md §4.1) — 32 bytes, hex.
EMAIL_ENCRYPTION_KEY=

# HMAC-SHA256 pepper for the email blind index (users.emailHash, SPEC.md §4.1).
EMAIL_HASH_PEPPER=

# --- Mail (SPEC.md §1 Stage 1: log/mailhog now, real smtp from Stage 11) ---

# 'log' (default, zero external deps — link is printed to the backend log)
# or 'smtp' (mailhog in dev via docker-compose.dev.yml, a real relay later).
MAIL_DRIVER=log
MAIL_FROM=no-reply@portfelika.com
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
